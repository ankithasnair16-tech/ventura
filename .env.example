# Ventura Environment Configuration
# This file is an example template. Do NOT put real secrets in this file.
# Copy this file to .env to configure local secrets if needed.

# Application Environment (development, staging, production)
VENTURA_ENV=development

# Optional Backup Air Quality API Token (WAQI / aqicn.org)
# Open-Meteo is the primary free API and requires no key.
WAQI_API_TOKEN=your_waqi_api_token_here

# Cache TTL in seconds (default is 1800 seconds = 30 minutes)
VENTURA_CACHE_TTL_SECONDS=1800

